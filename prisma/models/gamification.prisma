// ============================================================
// Gamification - Catalog content, wallet, indicators
// ============================================================

enum ProgressIndicatorKind {
  // SOFT bars
  FOOD_CHOICES
  FOOD_AND_WASTE
  HEALTH
  // SOFT wheels
  CO2_REDUCTION
  ENERGY_REDUCTION
  WATER_SAVINGS
  LAND_USE_REDUCTION
  // PRECISE nutrition
  PROTEIN
  FAT
  SUGAR
  SALT
  FIBER
  VITAMINS
  CALORIES
}

enum ProgressPrecision {
  SOFT
  PRECISE
}

enum WalletCurrency {
  XP
  POINTS
}

enum RewardSourceType {
  MISSION
  CHALLENGE
  QUEST
  QUIZ
  FOOD_FACT
}

enum ContentLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestContentType {
  MISSION
  CHALLENGE
  FOOD_FACT
  QUIZ
  MICRO_LEARNING
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Mission {
  id           String       @id @default(uuid())
  code         String       @unique
  ruleCode     String?
  dimensionId  String
  topicId      String?
  level        ContentLevel
  title        String
  duration     String
  goal         String
  whyItMatters String
  health       Boolean      @default(false)
  foodChoice   Boolean      @default(false)
  foodWaste    Boolean      @default(false)
  available    Boolean      @default(true)
  rewardId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  dimension         Dimension         @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  topic             Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  reward            Reward?           @relation("MissionReward", fields: [rewardId], references: [id], onDelete: SetNull)
  missionProgresses MissionProgress[]

  @@index([dimensionId])
  @@index([topicId])
  @@index([level])
  @@index([rewardId])
  @@index([ruleCode])
  @@map("missions")
}

model MissionProgress {
  userId      String
  missionId   String
  completed   Boolean        @default(false)
  progress    Float
  startedAt   DateTime?
  status      ProgressStatus  @default(NOT_STARTED)
  state       Json            @default("{}")
  ruleHash    String?
  evaluatedAt DateTime?

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([userId, missionId])
  @@map("mission_progress")
}

model Challenge {
  id           String       @id @default(uuid())
  code         String       @unique
  ruleCode     String?
  dimensionId  String
  topicId      String?
  level        ContentLevel
  title        String
  task         String
  whyItMatters String
  health       Boolean      @default(false)
  foodChoice   Boolean      @default(false)
  foodWaste    Boolean      @default(false)
  available    Boolean      @default(true)
  rewardId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  dimension           Dimension           @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  topic               Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  reward              Reward?             @relation("ChallengeReward", fields: [rewardId], references: [id], onDelete: SetNull)
  challengeProgresses ChallengeProgress[]

  @@index([dimensionId])
  @@index([topicId])
  @@index([level])
  @@index([rewardId])
  @@index([ruleCode])
  @@map("challenges")
}

model ChallengeProgress {
  userId      String
  challengeId String
  completed   Boolean        @default(false)
  progress    Float
  startedAt   DateTime?
  status      ProgressStatus  @default(NOT_STARTED)
  state       Json            @default("{}")
  ruleHash    String?
  evaluatedAt DateTime?

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([userId, challengeId])
  @@map("challenge_progress")
}

model FoodFact {
  id         String       @id @default(uuid())
  code       String       @unique
  topicId    String
  body       String
  source     String?
  level      ContentLevel
  health     Boolean      @default(false)
  foodChoice Boolean      @default(false)
  foodWaste  Boolean      @default(false)
  available  Boolean      @default(true)
  rewardId   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations
  topic    Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reward   Reward?             @relation("FoodFactReward", fields: [rewardId], references: [id], onDelete: SetNull)
  progress FoodFactProgress[]

  @@index([topicId])
  @@index([level])
  @@index([rewardId])
  @@map("food_facts")
}

model FoodFactProgress {
  id         String    @id @default(uuid())
  userId     String
  foodFactId String
  readAt     DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodFact FoodFact @relation(fields: [foodFactId], references: [id], onDelete: Cascade)

  @@unique([userId, foodFactId])
  @@index([userId])
  @@index([foodFactId])
  @@map("food_fact_progress")
}

model Quiz {
  id          String       @id @default(uuid())
  code        String       @unique
  topicId     String
  question    String
  explanation String
  source      String?
  level       ContentLevel
  health      Boolean      @default(false)
  foodChoice  Boolean      @default(false)
  foodWaste   Boolean      @default(false)
  available   Boolean      @default(true)
  rewardId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  topic    Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reward   Reward?             @relation("QuizReward", fields: [rewardId], references: [id], onDelete: SetNull)
  options  QuizOption[]
  progress QuizProgress[]

  @@index([topicId])
  @@index([level])
  @@index([rewardId])
  @@map("quizzes")
}

model QuizOption {
  id        String  @id @default(uuid())
  quizId    String
  label     String
  text      String
  isCorrect Boolean @default(false)
  sortOrder Int     @default(0)

  // Relations
  quiz               Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  selectedInProgress QuizProgress[]

  @@unique([quizId, label])
  @@index([quizId])
  @@map("quiz_options")
}

model QuizProgress {
  id               String    @id @default(uuid())
  userId           String
  quizId           String
  selectedOptionId String?
  isCorrect        Boolean?
  completed        Boolean   @default(false)
  answeredAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  selectedOption QuizOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
  @@map("quiz_progress")
}

model Quest {
  id          String       @id @default(uuid())
  code        String       @unique
  dimensionId String
  level       ContentLevel
  name        String?
  title       String?
  description String?
  available   Boolean      @default(true)
  rewardId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  dimension      Dimension       @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  reward         Reward?         @relation("QuestReward", fields: [rewardId], references: [id], onDelete: SetNull)
  items          QuestItem[]
  progress       QuestProgress[]
  currentUsers   User[]          @relation("UserCurrentQuest")
  currentGroups  UserGroup[]     @relation("GroupCurrentQuest")

  @@index([dimensionId])
  @@index([dimensionId, level])
  @@index([rewardId])
  @@map("quests")
}

model QuestItem {
  id          String           @id @default(uuid())
  questId     String
  contentType QuestContentType
  contentCode String
  sortOrder   Int              @default(0)

  // Relations
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([questId, contentType, contentCode])
  @@index([questId])
  @@map("quest_items")
}

model QuestProgress {
  userId String
  questId String
  /// When this quest became active for the user. Doubles as the "started"
  /// marker; there is deliberately no separate startedAt.
  unlockedAt DateTime?
  completed Boolean @default(false)
  /// Derived from item completion: finished / total * 100, rounded to 2dp.
  /// Never written from a client request.
  progress Float @default(0)
  status ProgressStatus @default(NOT_STARTED)
  /// Snapshot of the last derivation, so a surprising percentage can be
  /// explained without replaying events. See QuestProgressService.
  state Json @default("{}")
  evaluatedAt DateTime?

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@id([userId, questId])
  @@map("quest_progress")
}

model MicroLearning {
  id          String        @id @default(uuid())
  code        String        @unique
  dimensionId String?
  topicId     String?
  title       String
  body        String
  tips        String?
  media       Json          @default("{}")
  level       ContentLevel?
  health      Boolean       @default(false)
  foodChoice  Boolean       @default(false)
  foodWaste   Boolean       @default(false)
  available   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  dimension Dimension? @relation(fields: [dimensionId], references: [id], onDelete: SetNull)
  topic     Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([dimensionId])
  @@index([topicId])
  @@index([level])
  @@map("micro_learnings")
}

model Dimension {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  topics         Topic[]
  missions       Mission[]
  challenges     Challenge[]
  quests         Quest[]
  microLearnings MicroLearning[]

  @@index([sortOrder])
  @@map("dimensions")
}

model Topic {
  id          String   @id @default(uuid())
  dimensionId String
  code        String   @unique
  name        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  dimension      Dimension       @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  missions       Mission[]
  challenges     Challenge[]
  foodFacts      FoodFact[]
  quizzes        Quiz[]
  microLearnings MicroLearning[]

  @@index([dimensionId])
  @@index([sortOrder])
  @@map("topics")
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards      Reward[]
  earnedByUsers UserEarnedBadge[]

  @@map("badges")
}

model Reward {
  id                   String   @id @default(uuid())
  name                 String   @unique
  points               Int?
  xp                   Int?
  badgeId              String?
  avatarItem           String?
  petItem              String?
  collectible          String?
  collectibleShareable Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  badge         Badge?        @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  missions      Mission[]     @relation("MissionReward")
  challenges    Challenge[]   @relation("ChallengeReward")
  quests        Quest[]       @relation("QuestReward")
  quizzes       Quiz[]        @relation("QuizReward")
  foodFacts     FoodFact[]    @relation("FoodFactReward")
  walletEntries WalletEntry[]
  earnedBadges  UserEarnedBadge[]

  @@map("rewards")
}

model UserGamificationWallet {
  userId    String   @id
  xp        Int      @default(0)
  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnedBadges UserEarnedBadge[]

  @@map("user_gamification_wallets")
}

model UserEarnedBadge {
  id         String            @id @default(uuid())
  userId     String
  badgeId    String
  rewardId   String?
  sourceType RewardSourceType?
  sourceId   String?
  earnedAt   DateTime          @default(now())

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_earned_badges_userId_user_fkey")
  userGamificationWallet  UserGamificationWallet @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "user_earned_badges_userId_wallet_fkey")
  badge                   Badge                  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  reward                  Reward?                @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_earned_badges")
}

/// Append-only history of wallet balance changes (XP / points).
model WalletEntry {
  id           String            @id @default(uuid())
  userId       String
  currency     WalletCurrency
  amount       Int               // signed: credit > 0, debit < 0
  balanceAfter Int
  reason       String
  rewardId     String?           // set when credited by completing a content item
  sourceType   RewardSourceType?
  sourceId     String?           // id of the mission/challenge/quest/quiz
  eventId      String?
  createdAt    DateTime          @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward?    @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  event  UserEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([rewardId])
  @@index([eventId])
  @@map("wallet_entries")
}

/// Same shape for personal and group progress indicators.
/// Exactly one of userId / groupId must be set
/// (DB CHECK `progress_indicators_owner_xor` in manual migration).
model ProgressIndicator {
  id               String                @id @default(uuid())
  userId           String?
  groupId          String?
  kind             ProgressIndicatorKind
  precision        ProgressPrecision
  level            Int                   @default(1) // 1–5
  accumulatedValue Float                 @default(0) // current cycle
  targetValue      Float
  allTimeTotal     Float                 @default(0)
  cycleStartedAt   DateTime              @default(now())
  lastUpdatedAt    DateTime              @updatedAt

  user  User?      @relation("UserProgressIndicators", fields: [userId], references: [id], onDelete: Cascade)
  group UserGroup? @relation("GroupProgressIndicators", fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@unique([groupId, kind])
  @@index([userId])
  @@index([groupId])
  @@map("progress_indicators")
}

// ============================================================
// Foody personalization — cosmetic items for the Foody avatar
// ============================================================

enum FoodyItemType {
  ANTENNAS
  EARS
  GLASSES
}

/// Global catalog of Foody cosmetics. Six items per type.
/// `cost` describes the catalog entry; per-user ownership lives in
/// UserFoodyItem, so "owned" is never stored on the catalog row. An item is
/// locked for a user exactly while they do not own it.
model FoodyItem {
  id        String        @id @default(uuid())
  code      String        @unique // e.g. ANTENNAS_1
  type      FoodyItemType
  /// Position within a type, unique per type; drives display order and the item code.
  slot      Int
  /// Points charged on purchase. 0 makes the item free to claim.
  cost      Int           @default(0)
  available Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  ownedBy UserFoodyItem[]

  @@unique([type, slot])
  @@index([type])
  @@map("foody_items")
}

/// A user owning a Foody item, and whether it is currently worn.
/// At most one equipped item per type — enforced in FoodyService.equip(),
/// which unequips the siblings of that type inside the same transaction
/// (the type lives on FoodyItem, so a partial unique index here would need
/// the column duplicated onto this table).
model UserFoodyItem {
  userId      String
  foodyItemId String
  equipped    Boolean  @default(false)
  /// Points actually charged, kept for history: the catalog cost may change later.
  pricePaid   Int      @default(0)
  acquiredAt  DateTime @default(now())

  // Relations
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item FoodyItem @relation(fields: [foodyItemId], references: [id], onDelete: Cascade)

  @@id([userId, foodyItemId])
  @@index([userId])
  @@index([foodyItemId])
  @@map("user_foody_items")
}
