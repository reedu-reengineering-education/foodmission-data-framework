// ============================================================
// Consents - Consent form catalog (acceptances live on User.settings)
// ============================================================

model ConsentForm {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "terms_of_use", "privacy_notice"
  name      String // Internal label
  title     String // English source
  body      String   @db.Text // English source
  required  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consent_forms")
}
